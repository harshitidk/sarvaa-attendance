# ---------------------------------------------------------------------------
# Shared (safe to expose to the mobile app / browser — these are public keys)
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key (public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the admin dashboard (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets (NEVER expose to the client or mobile bundle)
# ---------------------------------------------------------------------------
# Supabase service-role key. Used only by server-side privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# Remote database connection string (Session pooler or Direct), used to apply
# migrations to a hosted project without Docker. Includes sslmode=require.
# Dashboard: Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Google Maps / Mapbox token for geofence visualization (admin, server or public)
NEXT_PUBLIC_MAPS_TOKEN=
